{
  "name": "numbase",
  "version": "0.1.2",
  "description": "Convert arbitrary-size decimal integers to and from custom radix alphabets, without runtime dependencies.",
  "main": "dist/numbase.min.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oe/NumBase.git"
  },
  "devDependencies": {
    "acorn": "^8.18.0",
    "terser": "^5.51.2",
    "typescript": "^5.9.3"
  },
  "author": {
    "company": "evecalm.com",
    "developer": "Saiya"
  },
  "keywords": [
    "big-integer",
    "big-number",
    "base-conversion",
    "radix",
    "base62",
    "custom-alphabet",
    "numbase"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/oe/NumBase/issues"
  },
  "homepage": "https://github.com/oe/NumBase#readme",
  "types": "dist/numbase.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.cjs",
    "typecheck": "tsc -p tsconfig.test.json",
    "check": "pnpm build && pnpm test && pnpm typecheck && pnpm test:package",
    "bench": "node scripts/benchmark.cjs",
    "prepublishOnly": "pnpm check",
    "test:package": "node scripts/test-package.cjs"
  },
  "packageManager": "pnpm@12.8.1"
}
