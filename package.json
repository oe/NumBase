{
  "name": "numbase",
  "version": "0.1.2",
  "description": "Precision-safe decimal integer and Base62 conversion with custom alphabets. Zero runtime dependencies.",
  "main": "dist/numbase.min.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oe/NumBase.git"
  },
  "devDependencies": {
    "acorn": "^8.18.0",
    "terser": "^5.51.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.2"
  },
  "author": {
    "company": "evecalm.com",
    "developer": "Saiya"
  },
  "keywords": [
    "big-integer",
    "big-number",
    "base-conversion",
    "radix",
    "base62",
    "custom-alphabet",
    "bigint",
    "integer",
    "encode",
    "decode",
    "numbase"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/oe/NumBase/issues"
  },
  "homepage": "https://github.com/oe/NumBase#readme",
  "types": "dist/numbase.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && pnpm build:types",
    "test": "node --test test/*.test.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit --emitDeclarationOnly false && pnpm typecheck:consumers",
    "check": "pnpm build && pnpm test && pnpm typecheck:consumers && pnpm test:package",
    "bench": "node scripts/benchmark.cjs",
    "prepublishOnly": "pnpm check",
    "test:package": "node scripts/test-package.cjs",
    "build:types": "tsc -p tsconfig.json && node scripts/build-types.mjs",
    "typecheck:consumers": "tsc -p tsconfig.test.json"
  },
  "packageManager": "pnpm@12.8.1"
}
